# Generate .env with: python scripts/init_env.py
EVAL_SECRET_KEY=
EVAL_ADMIN_USERNAME=admin
EVAL_ADMIN_PASSWORD=
# true for HTTPS; false only for a local HTTP installation
EVAL_SECURE_COOKIE=true
# Exact comma-separated hostnames for target APIs / custom LLM gateways.
# OpenAI and production/staging b-api hostnames are already allowed.
EVAL_ALLOWED_HOSTS=
EVAL_SESSION_HOURS=12
# Exact trusted reverse-proxy IPs/CIDRs; never use * on a publicly exposed port.
FORWARDED_ALLOW_IPS=127.0.0.1
# Local Compose: http://127.0.0.1:8080. Set 0.0.0.0 for a VPS reverse proxy.
EVAL_BIND_ADDRESS=127.0.0.1
EVAL_PORT=8080
